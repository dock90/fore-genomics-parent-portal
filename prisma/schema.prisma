generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  clerkId         String?         @unique
  email           String          @unique
  role            UserRole        @default(PARENT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  children        Child[]
  consents        Consent[]
  parentOrders    Order[]         @relation("ParentOrders")
  purchaserOrders Order[]         @relation("PurchaserOrders")
  questionnaires  Questionnaire[]
  profile         UserProfile?
  auditLogs       AuditLog[]
}

model UserProfile {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  firstName               String
  lastName                String
  address                 String
  addressLine2            String?
  city                    String
  state                   String
  zipCode                 String
  phone                   String
  communicationPreference CommunicationPreference  @default(EMAIL)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Child {
  id          String   @id @default(cuid())
  userId      String
  firstName   String?
  lastName    String?
  dob         String?
  sex         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dueDate     String?
  ethnicities String[] @default([])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kit         Kit?
  consents    Consent[]
}

model Consent {
  id                  String    @id @default(cuid())
  userId              String
  accepted            Boolean
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  ipAddress           String?
  part1Accepted       Boolean   @default(false)
  part2Accepted       Boolean   @default(false)
  part3Accepted       Boolean   @default(false)
  relationshipToChild RelationshipToChild?
  signature           String?
  signatureDate       DateTime?
  userAgent           String?
  consentAll          Boolean   @default(false)
  signerName          String?
  consentFileName     String?
  childId             String?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  child               Child?    @relation(fields: [childId], references: [id], onDelete: Cascade)
  kit                 Kit?
}

model Questionnaire {
  id               String   @id @default(cuid())
  userId           String
  question1        String   @default("false")
  question1Details String?
  question2        String   @default("false")
  question2Details String?
  question3        String   @default("false")
  question3Details String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  kit              Kit?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                          String             @id @default(cuid())
  orderNumber                 String             @unique
  status                      OrderStatus        @default(ORDER_RECEIVED)
  statusUpdatedAt             DateTime           @default(now())
  estimatedDelivery           DateTime?
  notes                       String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  inboundTrackingNumber       String?
  outboundTrackingNumber      String?
  kitCount                    Int                @default(1)
  postTestCounselingDate      DateTime?
  postTestCounselingEventId   String?
  postTestCounselingInviteeId String?
  preTestCounselingDate       DateTime?
  preTestCounselingEventId    String?
  preTestCounselingInviteeId  String?
  parentId                    String?
  purchaserId                 String
  auditLogs                   AuditLog[]
  kits                        Kit[]
  parent                      User?              @relation("ParentOrders", fields: [parentId], references: [id], onDelete: Cascade)
  purchaser                   User               @relation("PurchaserOrders", fields: [purchaserId], references: [id], onDelete: Cascade)
  parentInvitations           ParentInvitation[]
}

model Kit {
  id                        String         @id @default(cuid())
  orderId                   String
  kitNumber                 Int
  kitType                   KitType        @default(BASE)
  childId                   String?        @unique
  consentId                 String?        @unique
  questionnaireId           String?        @unique
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  reportFileName            String?
  parentReportFileName      String?
  pediatricianReportFileName String?
  fullLabReportFileName     String?
  trfFileName               String?
  trfApproved               Boolean        @default(false)
  trfApprovedAt             DateTime?
  trfApprovedBy             String?
  trfApprovedFileName       String?
  child                     Child?         @relation(fields: [childId], references: [id])
  consent                   Consent?       @relation(fields: [consentId], references: [id])
  order                     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  questionnaire             Questionnaire? @relation(fields: [questionnaireId], references: [id])
}

model ParentInvitation {
  id         String           @id @default(cuid())
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  notifiedAt DateTime?
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CalendlyToken {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  action    String
  userId    String?
  userEmail String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum UserRole {
  ADMIN
  COUNSELOR
  PARENT
  PURCHASER
}

enum OrderStatus {
  ONBOARDING_COMPLETED
  PREPARING_ORDER
  SHIPPED_TO_USER
  DELIVERED_AWAITING_RETURN
  SHIPPED_TO_LAB
  RECEIVED_IN_PROCESS
  COMPLETE_REPORT_DELIVERED
  COMPLETE_COUNSELING_REQUIRED
  COMPLETE_NO_COUNSELING_REQUIRED
  ORDER_RECEIVED
}

enum KitType {
  BASE
  PLUS
  PREMIUM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  DECLINED
}

enum RelationshipToChild {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

enum CommunicationPreference {
  EMAIL
  SMS
  BOTH
}
