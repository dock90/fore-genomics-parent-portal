// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(cuid())
  email                   String   @unique
  role                    UserRole @default(PARENT)
  profile                 UserProfile?
  children                Child[]
  consents                Consent[]
  questionnaires          Questionnaire[]
  orders                  Order[]
  preTestCounselingScheduled Boolean @default(false)
  preTestCounselingDate DateTime?
  preTestCounselingEventId String?
  preTestCounselingInviteeId String?
  postTestCounselingScheduled Boolean @default(false)
  postTestCounselingDate DateTime?
  postTestCounselingEventId String?
  postTestCounselingInviteeId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

enum UserRole {
  ADMIN
  COUNSELOR
  PARENT
}

model UserProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  firstName String
  lastName  String
  address   String
  city      String
  state     String
  zipCode   String
  phone     String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Child {
  id          String    @id @default(cuid())
  userId      String
  firstName   String?
  lastName    String?
  dob         String?   // Store as YYYY-MM-DD format
  dueDate     String?   // Store as YYYY-MM-DD format
  sex         String?
  ethnicities String[] @default([])  // Array field for multiple ethnicities
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Consent {
  id                String   @id @default(cuid())
  userId            String
  accepted          Boolean
  part1Accepted     Boolean  @default(false)
  part2Accepted     Boolean  @default(false)
  part3Accepted     Boolean  @default(false)
  consentAll        Boolean  @default(false)
  signature         String?  // Base64 encoded signature image
  signatureDate     DateTime?
  signerName        String?  // Name of the person signing the consent
  relationshipToChild String?
  childName         String?
  childDOB          String?   // Store as YYYY-MM-DD format
  ipAddress         String?
  userAgent         String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Questionnaire {
  id        String   @id @default(cuid())
  userId    String
  question1 Boolean
  question1Details String?
  question2 Boolean
  question2Details String?
  question3 Boolean
  question3Details String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  orderNumber String      @unique
  status      OrderStatus @default(ORDER_RECEIVED)
  statusUpdatedAt DateTime @default(now())
  estimatedDelivery DateTime?
  outboundTrackingNumber String?
  inboundTrackingNumber String?
  reportFileName String?
  notes       String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs   AuditLog[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OrderStatus {
  ORDER_RECEIVED
  ONBOARDING_COMPLETED
  PREPARING_ORDER
  SHIPPED_TO_USER
  DELIVERED_AWAITING_RETURN
  SHIPPED_TO_LAB
  RECEIVED_IN_PROCESS
  COMPLETE_REPORT_DELIVERED
}

model ParentInvitation {
  id                String   @id @default(cuid())
  childFirstName    String
  childLastName     String
  childDOB          String   // Store as YYYY-MM-DD format
  childSex          String
  childEthnicity    String
  parentName        String
  parentEmail       String
  initiatedBy       String   // "other" - who initiated this invitation
  initiatorEmail    String?  // Email of person who sent invitation
  notifiedAt        DateTime? // When notification was sent
  status            InvitationStatus @default(PENDING)
  invitationToken   String?  @unique // Secure token for invitation link
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  DECLINED
}

model CalendlyToken {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action      String   // "REPORT_UPLOAD", "REPORT_DOWNLOAD", "REPORT_ACCESS", "REPORT_DELETE"
  userId      String   // Clerk user ID
  userEmail   String   // User email for easier querying
  ipAddress   String?  // IP address of the action
  userAgent   String?  // Browser/user agent
  details     Json?    // Additional details like filename, file size, etc.
  createdAt   DateTime @default(now())
}
