# =====================================================================
# Fore Genomics Health Hub — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =====================================================================

# --- Database (Neon Postgres) ---
# Get from Neon dashboard → your project → Connection string
# If using Vercel-Neon integration, this is auto-injected; decouple before Hostinger migration
DATABASE_URL=

# --- Clerk Auth ---
# Get from Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Get from Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs (must match routes in your app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Where Clerk sends the user after they accept an invitation and set their password
NEXT_PUBLIC_CLERK_INVITATION_REDIRECT_URL=https://yourdomain.com/onboarding

# --- Shopify ---
# Get from Shopify Admin → Settings → Notifications → Webhooks → your endpoint → Signing Secret
# Register webhook: Event = "Order payment", URL = https://yourdomain.com/api/webhooks/shopify
SHOPIFY_WEBHOOK_SECRET=

# --- Stripe (used for direct Stripe checkout sessions, separate from Shopify) ---
# Get from Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
# Get from Stripe Dashboard → Developers → Webhooks → your endpoint → Signing Secret
# Register webhook for event: checkout.session.completed
# Webhook URL: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App Config ---
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# Comma-separated list of email addresses that can download approved TRFs
APPROVED_TRF_ACCESS_EMAILS=email@example.com
# Comma-separated list of admin emails for internal notifications
ADMIN_NOTIFICATION_EMAILS=kyle@foregenomics.com

# --- Email (SMTP / Gmail) ---
# Used by lib/email-service.ts for internal admin/counselor notifications
# Option A: Gmail App Password (easiest)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Option B: Custom SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Fore Genomics Health Hub <noreply@foregenomics.com>"

# --- Google Cloud Storage (TRF + Report PDFs) ---
# Get from GCP Console → IAM → Service Accounts → your service account → Keys
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_PRIVATE_KEY_ID=your-private-key-id
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLOUD_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_CLOUD_CLIENT_ID=your-client-id
GOOGLE_CLOUD_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com
GOOGLE_CLOUD_STORAGE_BUCKET=fore-genomics-trfs
GOOGLE_CLOUD_APPROVED_TRF_BUCKET=fore-genomics-approved-trfs
GOOGLE_CLOUD_REPORTS_BUCKET=fore-genomics-reports-prod

# --- Calendly OAuth ---
# Get from Calendly Developer Portal → OAuth Apps
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=https://yourdomain.com/api/calendly/oauth/callback

# --- PDF Generation (Browserless) ---
# Get from browserless.io → your account → API token
BROWSERLESS_TOKEN=

# --- Optional Tuning ---
# Number of days before an ORDER_RECEIVED order triggers an "Incomplete Onboarding" alert
ONBOARDING_INCOMPLETE_THRESHOLD_DAYS=7
# Number of days before a DELIVERED_AWAITING_RETURN order triggers a "Kit Not Returned" alert
KITS_AWAITING_RETURN_THRESHOLD_DAYS=14
